<Window x:Class="WeaponSmith.Dialogs.SaveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unsaved Changes"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap" MaxWidth="380"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save" Width="90" IsDefault="True" Click="Save_Click"/>
            <Button Content="Don't Save" Width="90" Margin="10,0,0,0" Click="DontSave_Click"/>
            <Button Content="Cancel" Width="90" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
